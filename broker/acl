# Permissões do broker (contrato v1, CONTRATOS.md).
# Regras por usuário (não "pattern": pattern vale para todos e deixaria o
# monitor publicar como se fosse o dispositivo, bastando usar o client id
# dele). Limite: os dispositivos compartilham o usuário e não são isolados
# entre si; se o R13 for adiante, usar um usuário por dispositivo
# (pattern com %u).

# ESP32: publica o que o contrato define e lê só os comandos
user dispositivo
topic write garagem/v1/+/telemetria
topic write garagem/v1/+/vaga/+/estado
topic write garagem/v1/+/rfid
topic write garagem/v1/+/ack
topic write garagem/v1/+/status
topic read garagem/v1/+/cmd

# Backend, assinante operador (ADR 0005): lê tudo do contrato e é o
# único que publica comandos
user backend
topic read garagem/v1/#
topic write garagem/v1/+/cmd

# Backend, assinante persistencia: só lê (grava no banco, nunca publica)
user persistencia
topic read garagem/v1/#

# Backend, assinante motorista (API pública do app do celular): só lê
# estado das vagas, status e RFID; nunca publica
user motorista
topic read garagem/v1/+/vaga/+/estado
topic read garagem/v1/+/status
topic read garagem/v1/+/rfid

# Monitor (equipe, testes com mosquitto_sub/MQTTX): só leitura
user monitor
topic read garagem/#
topic read $SYS/#
