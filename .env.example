# Variáveis do docker compose. Copie para .env e troque as senhas.
# O .env não vai para o git.

# Portas do broker no servidor
MQTT_PORTA=1883
MQTT_PORTA_WS=9001

# ESP32 (vai no secrets.h do firmware: MQTT_USER / MQTT_PASSWORD)
MQTT_DISPOSITIVO_USER=dispositivo
MQTT_DISPOSITIVO_PASSWORD=troque-esta-senha

# Backend (único que publica comandos)
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=troque-esta-senha

# Equipe: leitura para testes (mosquitto_sub, MQTTX)
MQTT_MONITOR_USER=monitor
MQTT_MONITOR_PASSWORD=troque-esta-senha
