# Variáveis do docker compose. Copie para .env e troque as senhas.
# O .env não vai para o git. Os nomes de usuário MQTT precisam bater com
# os de broker/acl.

# Portas do broker no servidor
MQTT_PORTA=1883
MQTT_PORTA_WS=9001

# ESP32 e simulador (vai no secrets.h do firmware: MQTT_USER / MQTT_PASSWORD)
MQTT_DISPOSITIVO_USER=dispositivo
MQTT_DISPOSITIVO_PASSWORD=troque-esta-senha

# ESP32 atuador dos LEDs (vai no secrets.h de src/atuador; ADR 0008)
MQTT_ATUADOR_USER=atuador
MQTT_ATUADOR_PASSWORD=troque-esta-senha

# Backend, assinante operador (único que publica comandos)
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=troque-esta-senha

# Backend, assinante persistencia (só leitura; grava no banco)
MQTT_PERSISTENCIA_USER=persistencia
MQTT_PERSISTENCIA_PASSWORD=troque-esta-senha

# Backend, assinante motorista (só leitura de estado, status e RFID)
MQTT_MOTORISTA_USER=motorista
MQTT_MOTORISTA_PASSWORD=troque-esta-senha

# Equipe: leitura para testes (mosquitto_sub, MQTTX)
MQTT_MONITOR_USER=monitor
MQTT_MONITOR_PASSWORD=troque-esta-senha

# PostgreSQL. A senha entra numa URL: use só letras, números, - e _
POSTGRES_DB=horangotango
POSTGRES_USER=horangotango
POSTGRES_PASSWORD=troque-esta-senha

# API do operador (painel). JWT_SEGREDO precisa de 32+ caracteres
# aleatórios; com o valor abaixo o operador não sobe. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OPERADOR_PORTA=8000
JWT_SEGREDO=troque-este-segredo
# Administrador criado na primeira subida. Depois troque a senha
# pela API (POST /api/eu/senha) ou pelo painel
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha

# Alertas no Telegram (opcional; vazio = alertas só no painel).
# Token do @BotFather e id do chat/grupo que recebe os alertas
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Páginas abertas de outro endereço (ex.: painel em desenvolvimento)
# que podem chamar as APIs; separadas por vírgula. Vazio = nenhuma
CORS_ORIGENS=

# API do app do motorista (pública, sem login)
MOTORISTA_PORTA=8001
